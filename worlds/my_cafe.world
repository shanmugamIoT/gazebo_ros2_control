<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="cafe_world">
    <!-- Light -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <!-- Home Position Marker -->
    <include>
      <uri>model://home_maker</uri>
      <name>home</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>
    <!-- Kitchen -->
    <include>
      <uri>model://kitchen</uri>
      <name>kitchen</name>
      <pose>1 3 0 0 0 0</pose>
      <static>true</static>
    </include>
    <!-- Tables -->
    <include>
      <uri>model://table</uri>
      <name>table1</name>
      <pose>8 2 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>model://table</uri>
      <name>table2</name>
      <pose>8 5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>model://table</uri>
      <name>table3</name>
      <pose>8 8 0 0 0 0</pose>
      <static>true</static>
    </include>
    <!-- Walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>5 10 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>5 -1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>10 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 10 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 10 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-1 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 10 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 10 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
